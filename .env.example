NODE_ENV=development
TZ=America/Sao_Paulo

DATABASE_URL=postgresql://pulse:pulse@localhost:5432/wlinks_pulse?schema=public
REDIS_URL=redis://localhost:6379

OIDC_ISSUER_URL=http://localhost:8080/realms/wlinks-pulse
OIDC_CLIENT_ID=wlinks-pulse-web
OIDC_API_AUDIENCE=wlinks-pulse-api

IXC_BASE_URL=https://ixc.example.internal
IXC_API_TOKEN=replace_me
IXC_REQUEST_TIMEOUT_MS=10000

OMNIETALK_BASE_URL=https://omnitalk.example.internal
OMNIETALK_API_TOKEN=replace_me

GC_BASE_URL=https://gc.example.internal
GC_API_TOKEN=replace_me

OPENAI_API_KEY=replace_me
OPENAI_MODEL=configure_in_environment

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=relacionamento@wlinks.com.br

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=pulse
S3_SECRET_KEY=replace_me
S3_BUCKET=wlinks-pulse

LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
